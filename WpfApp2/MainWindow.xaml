<Window x:Class="WpfApp2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WpfApp2"
    Title="Метод Ньютона" Height="800" Width="1200"
    MinHeight="640" MinWidth="920" WindowStartupLocation="CenterScreen"
    Background="#F4F5F7" Foreground="#20252B" FontFamily="Segoe UI" FontSize="14"
    TextOptions.TextFormattingMode="Display" Closed="onWindowClosed">
  <Window.Resources>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Foreground" Value="#374151"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C9CED6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#20252B"/>
      <Setter Property="BorderBrush" Value="#C9CED6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="buttonBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="buttonBorder" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
        HorizontalAlignment="Left" x:Name="sidebarView">
      <StackPanel Width="286" Margin="6,4,8,4" x:Name="sidebarContent">
        <TextBlock Text="Параметры" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Label Content="Интервал (старт x₀ = a)" Target="{Binding ElementName=aText}"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="aText" Text="-2" TextChanged="onInputChanged"
              AutomationProperties.Name="Левая граница a"/>
          <TextBlock Grid.Column="1" Text=";" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBox x:Name="bText" Grid.Column="2" Text="3" TextChanged="onInputChanged"
              AutomationProperties.Name="Правая граница b"/>
        </Grid>
        <Label Content="Функция f(x)" Target="{Binding ElementName=formulaText}"/>
        <TextBox x:Name="formulaText" Text="x^2+2*x-6" Margin="0,0,0,10"
            TextChanged="onInputChanged"/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="Знаков после ," ToolTip="ε = 10⁻ⁿ: допуск невязки и поправки Ньютона, без гарантии погрешности результата" Target="{Binding ElementName=digitsText}"/>
            <TextBox x:Name="digitsText" Text="3" TextChanged="onInputChanged"
                AutomationProperties.Name="Знаков после запятой"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Что найти" Target="{Binding ElementName=modeBox}"/>
            <ComboBox x:Name="modeBox" SelectedIndex="0" Height="38" Padding="8,6"
                SelectionChanged="onModeChanged" AutomationProperties.Name="Что найти">
              <ComboBoxItem Content="Корень"/><ComboBoxItem Content="Минимум"/><ComboBoxItem Content="Максимум"/>
            </ComboBox>
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="solveButton" Content="Рассчитать" Click="onSolveClick"
              IsDefault="True" Background="#0969DA" Foreground="White"
              BorderBrush="#0969DA" FontWeight="SemiBold"/>
          <Button x:Name="clearButton" Grid.Column="2" Content="Очистить" Click="onClearClick"/>
          <Button x:Name="cancelButton" Grid.ColumnSpan="3" Content="Отменить" Click="onCancelClick"
              Visibility="Collapsed"/>
        </Grid>
        <TextBlock Text="Ответ" Foreground="#6B7280" Margin="0,16,0,6"/>
        <TextBlock x:Name="resultText" FontSize="20" TextWrapping="Wrap"
            AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="statusText" TextWrapping="Wrap" Foreground="#6B7280"
            Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="plotProgressText" TextWrapping="Wrap" Foreground="#6B7280"
            Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="errorText" TextWrapping="Wrap" Foreground="Firebrick"
            Margin="0,6,0,0" AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
    </Viewbox>
    <Border Grid.Column="2" Background="White" BorderBrush="#D5D9DF"
        BorderThickness="1" CornerRadius="5" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <local:PlotControl x:Name="plotSurface" KeyDown="onPlotKeyDown"
              AutomationProperties.Name="График функции"
              ToolTip="Колесо — масштаб; перетаскивание левой кнопкой — перемещение"/>
          <TextBlock x:Name="emptyPlotText" Text="Введите данные и нажмите «Рассчитать»."
              Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"
              TextWrapping="Wrap" Margin="20" IsHitTestVisible="False"/>
        </Grid>
        <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="118"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="118"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="previousButton" Content="← Назад" IsEnabled="False"
                Click="onPreviousClick"/>
            <TextBlock x:Name="stepText" Grid.Column="1" Text="Шаг —"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="nextButton" Grid.Column="2" Content="Далее →"
                IsEnabled="False" Click="onNextClick"/>
            <Button x:Name="lastButton" Grid.Column="4" Content="К результату"
                IsEnabled="False" Click="onLastClick"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
