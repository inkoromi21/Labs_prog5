root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
max_line_length = 100
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

dotnet_naming_rule.methods_use_camel_case.symbols = methods
dotnet_naming_rule.methods_use_camel_case.style = camel_case
dotnet_naming_rule.methods_use_camel_case.severity = suggestion
dotnet_naming_symbols.methods.applicable_kinds = method, property
dotnet_naming_symbols.methods.applicable_accessibilities = *

dotnet_naming_rule.fields_use_camel_case.symbols = fields
dotnet_naming_rule.fields_use_camel_case.style = camel_case
dotnet_naming_rule.fields_use_camel_case.severity = suggestion
dotnet_naming_symbols.fields.applicable_kinds = field
dotnet_naming_symbols.fields.applicable_accessibilities = *

dotnet_naming_rule.constants_use_upper_case.symbols = constants
dotnet_naming_rule.constants_use_upper_case.style = upper_case
dotnet_naming_rule.constants_use_upper_case.severity = suggestion
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.upper_case.capitalization = all_upper
dotnet_naming_style.upper_case.word_separator = _
